# Copy to .env.local for development. Put production values in Vercel →
# Project → Settings → Environment Variables (and Supabase secrets for Edge
# Functions). NEVER commit real values.

# ── App ──────────────────────────────────────────────────────────────────
# memory = built-in demo data (default, resets on restart). supabase = live database.
DATA_BACKEND=memory
# Public base URL, used in site QR codes. Falls back to the request host.
NEXT_PUBLIC_APP_URL=
# Hosted demo gate: one admin email + password protects the whole site.
# Leave blank locally (site runs open). On Vercel both are REQUIRED; without
# them the deployed site refuses to serve. Removed once Supabase Auth is live.
ACCESS_EMAIL=
ACCESS_PASSWORD=
# Shared secret Vercel Cron sends to /api/cron/* (and Edge Functions check).
CRON_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────
# Used when DATA_BACKEND=supabase: the timeclock-db Edge Function URL and the
# key whose SHA-256 is stored in timeclock_private.server_keys.
TIMECLOCK_DB_URL=
TIMECLOCK_DB_KEY=
# For Supabase Auth later (not used yet).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/background jobs only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Payroll (per-app OAuth credentials; per-company tokens live in Vault) ─
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_WEBHOOK_VERIFIER=
WAGEPOINT_API_KEY=
WAGEPOINT_COMPANY_ID=
DAYFORCE_CLIENT_ID=
DAYFORCE_CLIENT_SECRET=
DAYFORCE_COMPANY_NAMESPACE=
ADP_CLIENT_ID=
ADP_CLIENT_SECRET=
ADP_CERT_PEM=
ADP_KEY_PEM=

# ── Messaging ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
